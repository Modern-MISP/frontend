{
  "name": "misp-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "vite build",
    "start:misp": "docker compose -f misp-docker/docker-compose.yml up",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test:open": "cypress open",
    "lint": "oxlint",
    "format": "prettier --write . '!misp-docker/**'",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "gen:api-types": "openapi-typescript https://raw.githubusercontent.com/MISP/MISP/develop/app/webroot/doc/openapi.yaml -o src/lib/api/misp.d.ts"
  },
  "devDependencies": {
    "@4tw/cypress-drag-drop": "^2.3.0",
    "@catppuccin/tailwindcss": "^1.0.0-beta.2",
    "@dagrejs/dagre": "^1.1.5",
    "@iconify/svelte": "^4.2.0",
    "@melt-ui/pp": "^0.3.2",
    "@melt-ui/svelte": "^0.86.6",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.22.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@xyflow/svelte": "^1.2.1",
    "autoprefixer": "^10.4.21",
    "bun": "^1.2.18",
    "cypress": "^14.5.1",
    "date-fns": "^4.1.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "lodash-es": "^4.17.21",
    "openapi-fetch": "^0.14.0",
    "openapi-typescript": "^7.8.0",
    "oxlint": "^1.6.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.35.4",
    "svelte-check": "^4.2.2",
    "tailwindcss": "^4.1.11",
    "ts-extras": "^0.14.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "vitest-fetch-mock": "^0.4.5"
  },
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "@zxcvbn-ts/matcher-pwned": "^3.0.4",
    "bunx": "^0.1.0",
    "mmisp-api-client": "^0.8.0",
    "svelte-heatmap": "github:Studsministern/svelte-heatmap#master"
  }
}
